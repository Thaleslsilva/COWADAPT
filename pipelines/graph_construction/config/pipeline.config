#!/bin/bash
################################################################################
# Central configuration for the graph_construction pipeline.
#
# Shell scripts source this file; Python scripts read it through
# src/02_graph_statistics/graph_level/config_loader.py. Keep it to plain
# KEY=value lines (plus PROJECT_ROOT below) so that both can parse it.
#
# Only values shared by several scripts belong here. A script-specific override
# (e.g. a lower thread count for a memory-constrained tool) stays in that script.
################################################################################

# Root of this pipeline folder, detected from the location of this file
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Reference path/sample prefix used inside the graph (must match the Cactus seqFile)
REF=ARS_UCD2

# Non-reference sample/haplotype identifiers used by the intersection,
# novel-sequence and core/flex analyses
SAMPLES=GIR_hap,GUZ_hap,SIN_hap,TAB_hap,NEL_019,NEL_020,NEL_011,NEL_005,NEL_010,NEL_017

# Prefix of the final pangenome graph files (.gfa / .og / .vg ...), as in the Zenodo record
PANGENOME_PREFIX=IND_pangenome_final

# Default thread count for steps without a specific resource constraint
DEFAULT_THREADS=100
