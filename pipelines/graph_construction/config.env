# Central configuration for the pan_IND_artigo pipeline.
# Shell scripts: `source` this file (adjust the relative path to its depth).
# Python scripts: use config_loader.py (resIND_pangenome/scripts/config_loader.py).
#
# Only values shared across multiple scripts belong here. A script-specific
# override (e.g. a lower thread count for a memory-constrained tool) should
# stay hardcoded in that script.

# Reference genome ID used across the pangenome graph (must match seqFile.txt)
REF=ARS_UCD2

# Non-reference sample/haplotype identifiers used across intersection,
# novel-sequence, and core/flex analyses
SAMPLES=GIR_hap,GUZ_hap,SIN_hap,TAB_hap,NEL_019,NEL_020,NEL_011,NEL_005,NEL_010,NEL_017

# Prefix used for the final pangenome graph outputs (.gfa/.og/.vg/...)
PANGENOME_PREFIX=IND_pangenome_final

# Default thread count for steps that don't have a specific resource constraint
DEFAULT_THREADS=100

# Absolute path to the project root on the server where the pipeline runs
BASE_DIR=/home/bt-h1/KG000421/pangenome/pan_IND_artigo
